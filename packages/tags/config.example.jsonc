{
  // "openai" denotes any OpenAI-compatible endpoint (base_url is used as-is, usually ending with /v1),
  // "anthropic" denotes Claude (the SDK appends /v1/messages automatically; base_url should not end with /v1)
  "model_provider": "openai",
  "chat_model": {
    "api_key": "your-api-key",
    "base_url": "https://ark.cn-beijing.volces.com/api/v3",
    // Must be a vision model (VLM)
    "model": "doubao-seed-1.6-vision-250715",
    "max_tokens": 1024,
  },
  // Slicing granularity (seconds)
  "segment_seconds": 60,
  // Number of representative frames extracted per segment
  "frames_per_segment": 3,
  // Number of segments processed concurrently
  "concurrency": 2,
  // Width (px) to which representative frames are scaled; height keeps aspect ratio, controlling token cost
  "frame_width": 768,
}
